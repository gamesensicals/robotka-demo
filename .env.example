# Demo Robotky – stačí pár premenných (na Rendri ich nastaví render.yaml).
# Podpis prihlásenia a odkazov na súbory (ľubovoľný dlhý náhodný reťazec)
SESSION_SECRET=dev-session-secret
FILES_SECRET=dev-files-secret
# Kde je databáza a súbory dema (každú hodinu sa zmažú a nahrajú znova)
DATA_DIR=./data
# Verejná adresa dema
APP_URL=http://localhost:3000
# Ako často sa demo vracia do pôvodného stavu (minúty, predvolene 60 = každú celú hodinu)
DEMO_RESET_MINUTES=60
